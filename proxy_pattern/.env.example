# LiteLLM Proxy Environment Variables
# This file shows what you CAN customize (all optional except OPENAI_API_KEY)

# ============================================================================
# REQUIRED: Your OpenAI API Key
# ============================================================================
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================================================
# OPTIONAL: Security Keys (auto-generated if not set)
# ============================================================================

# Master key for admin access (will use default if not set)
# Generate with: openssl rand -hex 32 | awk '{print "sk-"$1}'
# LITELLM_MASTER_KEY=sk-your-generated-key

# Salt key for encrypting API credentials (will use default if not set)
# IMPORTANT: Cannot be changed after first use!
# Generate with: openssl rand -base64 32
# LITELLM_SALT_KEY=your-generated-salt

# ============================================================================
# OPTIONAL: Database Configuration (defaults provided)
# ============================================================================

# POSTGRES_DB=litellm
# POSTGRES_USER=litellm_user
# POSTGRES_PASSWORD=auto-generated-if-not-set

# ============================================================================
# OPTIONAL: Redis Configuration (defaults provided)
# ============================================================================

# REDIS_PASSWORD=auto-generated-if-not-set

# ============================================================================
# OPTIONAL: Server Configuration
# ============================================================================

# LITELLM_PORT=4000
# WORKER_COUNT=4
# LITELLM_LOG=INFO
# TZ=UTC

# ============================================================================
# OPTIONAL: Security Settings
# ============================================================================

# SSL_VERIFY=true
# ALLOWED_ORIGINS=http://localhost:4000
# LITELLM_TELEMETRY=False
# LITELLM_REQUEST_LOGS=True
