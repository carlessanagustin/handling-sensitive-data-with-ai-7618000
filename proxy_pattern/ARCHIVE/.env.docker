# Docker Compose Environment Variables
# This file is automatically loaded by docker compose
# You only need to set OPENAI_API_KEY - everything else has secure defaults

# ============================================================================
# REQUIRED: Your OpenAI API Key
# ============================================================================
OPENAI_API_KEY=

# ============================================================================
# OPTIONAL: Override defaults for production
# ============================================================================

# Master key for admin access (default: sk-1234567890abcdef)
# Generate with: openssl rand -hex 32 | awk '{print "sk-"$1}'
# LITELLM_MASTER_KEY=

# Salt key for encryption (default: auto-generated)
# IMPORTANT: Cannot be changed after first use!
# Generate with: openssl rand -base64 32
# LITELLM_SALT_KEY=

# Database password (default: auto-generated)
# POSTGRES_PASSWORD=

# Redis password (default: auto-generated)
# REDIS_PASSWORD=

# ============================================================================
# OPTIONAL: Server Configuration
# ============================================================================

# LITELLM_PORT=4000
# WORKER_COUNT=4
# LITELLM_LOG=INFO
# TZ=UTC
# SSL_VERIFY=true
# LITELLM_TELEMETRY=False
# LITELLM_REQUEST_LOGS=True
